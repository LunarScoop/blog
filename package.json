{
  "name": "personal-knowledge-garden",
  "type": "module",
  "version": "0.10.0",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=11.9.0"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "test": "node --experimental-strip-types --test tests/content-utils.test.ts tests/knowledge-utils.test.ts tests/markdown-plugins.test.ts",
    "check": "astro check",
    "build": "astro check && astro build && pagefind --site dist",
    "verify:build": "node scripts/audit-build.mjs",
    "verify:search": "node scripts/verify-search.mjs",
    "preview": "astro preview",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.2.1",
    "@astrojs/mdx": "7.0.3",
    "@astrojs/rss": "4.0.19",
    "@astrojs/sitemap": "3.7.3",
    "@expressive-code/plugin-line-numbers": "0.44.1",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.1.3",
    "astro-expressive-code": "0.44.1",
    "katex": "0.18.1",
    "mermaid": "11.16.0",
    "rehype-katex": "7.0.1",
    "remark-math": "6.0.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@types/node": "24.13.3",
    "pagefind": "1.5.2",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "~6.0.3"
  }
}
