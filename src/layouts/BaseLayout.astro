---
import Footer from "../components/shared/Footer.astro";
import Navbar from "../components/shared/Navbar.astro";
import { SITE } from "../config/site";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  type?: "website" | "article";
  publishedTime?: Date;
  updatedTime?: Date;
  image?: string;
}

const {
  title,
  description = SITE.description,
  noindex = false,
  type = "website",
  publishedTime,
  updatedTime,
  image = SITE.socialImage,
} = Astro.props;
const pageTitle = title ? `${title} | ${SITE.name}` : SITE.name;
const pathname = Astro.url.pathname === "/" ? "/" : `${Astro.url.pathname.replace(/\/+$/, "")}/`;
const siteUrl = Astro.site ?? new URL(Astro.url.origin);
const canonicalUrl = new URL(pathname, siteUrl);
const socialImageUrl = new URL(image, siteUrl);
---

<!doctype html>
<html lang={SITE.language} data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="author" content={SITE.author} />
    {noindex && <meta name="robots" content="noindex,nofollow" />}
    <meta name="theme-color" content="#f4f5f6" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0f1117" media="(prefers-color-scheme: dark)" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" type="application/rss+xml" title={`${SITE.name} RSS`} href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content={SITE.locale} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:alt" content={`${SITE.name} 社交分享图`} />
    {
      publishedTime && (
        <meta property="article:published_time" content={publishedTime.toISOString()} />
      )
    }
    {updatedTime && <meta property="article:modified_time" content={updatedTime.toISOString()} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    <title>{pageTitle}</title>
    <script is:inline>
      (() => {
        const storageKey = "knowledge-garden-theme";
        let storedTheme = null;

        try {
          storedTheme = window.localStorage.getItem(storageKey);
        } catch {
          storedTheme = null;
        }

        const theme =
          storedTheme === "light" || storedTheme === "dark"
            ? storedTheme
            : window.matchMedia("(prefers-color-scheme: dark)").matches
              ? "dark"
              : "light";

        document.documentElement.dataset.theme = theme;
        document.documentElement.style.colorScheme = theme;
      })();
    </script>
  </head>
  <body class="min-h-dvh antialiased">
    <a
      href="#main-content"
      class="fixed top-3 left-3 z-50 -translate-y-24 rounded-xl bg-stone-950 px-4 py-2 text-sm font-semibold text-white transition focus:translate-y-0 focus:outline-2 focus:outline-offset-2 focus:outline-indigo-300 motion-reduce:transition-none dark:bg-white dark:text-stone-950"
    >
      跳到主要内容
    </a>
    <div class="site-shell flex min-h-dvh flex-col">
      <Navbar />
      <main id="main-content" class="flex-1">
        <slot />
      </main>
      <Footer />
    </div>
  </body>
</html>
