---
import MarkdownContent from "../components/markdown/MarkdownContent.astro";
import Container from "../components/shared/Container.astro";
import { formatDate } from "../utils/format";
import type { ProjectEntry } from "../utils/projects";
import BaseLayout from "./BaseLayout.astro";

interface Props {
  project: ProjectEntry;
}

const { project } = Astro.props;
const statusLabels = {
  planning: "规划中",
  building: "构建中",
  completed: "已完成",
  archived: "已归档",
} as const;
const updatedAt = project.data.updated ?? project.data.created;
---

<BaseLayout
  title={project.data.title}
  description={project.data.description}
  type="article"
  publishedTime={project.data.created}
  updatedTime={project.data.updated}
>
  <Container class="py-10 sm:py-16">
    <article class="material-surface mx-auto max-w-4xl overflow-hidden">
      <header class="px-6 py-9 sm:px-12 sm:py-12">
        <nav class="text-sm text-stone-500 dark:text-stone-400" aria-label="面包屑">
          <a
            href="/projects"
            class="rounded-sm transition hover:text-indigo-700 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-700 dark:hover:text-indigo-300 dark:focus-visible:outline-indigo-300"
          >
            Projects
          </a>
          <span class="mx-2" aria-hidden="true">/</span>
          <span>{project.data.title}</span>
        </nav>

        <div class="mt-8 flex flex-wrap items-center gap-3">
          <span class="tag-chip px-3 py-1 text-xs font-semibold">
            {statusLabels[project.data.status]}
          </span>
          {
            project.data.featured && (
              <span class="text-xs font-bold tracking-[0.14em] text-amber-600 uppercase dark:text-amber-300">
                Featured
              </span>
            )
          }
        </div>

        <h1
          class="page-title mt-5 font-display text-4xl font-bold tracking-[-0.035em] text-balance text-stone-950 sm:text-6xl dark:text-stone-50"
        >
          {project.data.title}
        </h1>
        <p
          class="page-description mt-5 max-w-3xl text-base leading-8 text-stone-600 sm:text-lg dark:text-stone-300"
        >
          {project.data.description}
        </p>

        <div class="mt-8 flex flex-col gap-5 border-t border-stone-200 pt-7 dark:border-stone-800">
          <ul class="flex flex-wrap gap-2" aria-label="技术栈">
            {
              project.data.technologies.map((technology) => (
                <li class="tag-chip px-2.5 py-1 font-mono text-xs">{technology}</li>
              ))
            }
          </ul>

          <div class="flex flex-wrap items-center justify-between gap-4">
            <p class="text-sm text-stone-500 dark:text-stone-400">
              创建于 <time datetime={project.data.created.toISOString()}>
                {formatDate(project.data.created)}
              </time>
              <span class="mx-2" aria-hidden="true">·</span>
              更新于 <time datetime={updatedAt.toISOString()}>{formatDate(updatedAt)}</time>
            </p>

            {
              (project.data.github || project.data.demo) && (
                <div class="flex flex-wrap gap-3" aria-label="项目链接">
                  {project.data.github && (
                    <a
                      href={project.data.github}
                      target="_blank"
                      rel="noreferrer"
                      class="inline-flex min-h-11 items-center rounded-xl border border-stone-300 px-4 text-sm font-semibold text-stone-700 transition hover:border-indigo-600 hover:text-indigo-800 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-700 dark:border-stone-700 dark:text-stone-200 dark:hover:border-indigo-400 dark:hover:text-indigo-200 dark:focus-visible:outline-indigo-300"
                    >
                      GitHub
                    </a>
                  )}
                  {project.data.demo && (
                    <a
                      href={project.data.demo}
                      target="_blank"
                      rel="noreferrer"
                      class="inline-flex min-h-11 items-center rounded-xl bg-indigo-600 px-4 text-sm font-semibold text-white transition hover:bg-indigo-700 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-700 dark:bg-indigo-500 dark:text-white dark:hover:bg-indigo-400 dark:focus-visible:outline-indigo-300"
                    >
                      在线演示
                    </a>
                  )}
                </div>
              )
            }
          </div>
        </div>
      </header>

      <div
        class="border-t border-stone-200 px-6 py-9 sm:px-12 sm:py-12 dark:border-stone-800"
        data-pagefind-body
      >
        <span data-pagefind-meta="type:Project" hidden></span>
        <span data-pagefind-meta={`title:${project.data.title}`} hidden></span>
        <p class="sr-only">{project.data.description}</p>
        <MarkdownContent>
          <slot />
        </MarkdownContent>
      </div>
    </article>

    <a
      href="/projects"
      class="material-link mx-auto mt-8 flex min-h-11 max-w-4xl items-center gap-2 px-3 text-sm font-semibold focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-700 dark:focus-visible:outline-indigo-300"
    >
      <span aria-hidden="true">←</span>
      返回 Projects
    </a>
  </Container>
</BaseLayout>
