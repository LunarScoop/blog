---
import type { ProjectEntry } from "../../utils/projects";
import Container from "../shared/Container.astro";
import ProjectCard from "../projects/ProjectCard.astro";

interface Props {
  projects: ProjectEntry[];
}

const { projects } = Astro.props;
---

{
  projects.length > 0 && (
    <section class="content-section" aria-labelledby="featured-projects-heading">
      <Container>
        <div class="flex items-end justify-between gap-5">
          <div>
            <p class="section-kicker text-xs font-bold tracking-[0.2em] text-indigo-700 uppercase dark:text-indigo-300">
              Featured Projects
            </p>
            <h2
              id="featured-projects-heading"
              class="section-title mt-3 font-display text-3xl font-bold text-stone-950 dark:text-stone-50"
            >
              精选项目
            </h2>
          </div>
          <a
            href="/projects"
            class="inline-flex min-h-11 items-center rounded-xl px-3 text-sm font-semibold text-stone-600 hover:bg-stone-200/70 hover:text-indigo-800 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-700 dark:text-stone-300 dark:hover:bg-stone-800 dark:hover:text-indigo-200 dark:focus-visible:outline-indigo-300"
          >
            全部项目{" "}
            <span class="ml-2" aria-hidden="true">
              →
            </span>
          </a>
        </div>
        <div class="mt-8 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
          {projects.map((project) => (
            <ProjectCard project={project} compact />
          ))}
        </div>
      </Container>
    </section>
  )
}
