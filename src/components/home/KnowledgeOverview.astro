---
import { DOMAINS } from "../../config/subjects";
import type { NoteEntry } from "../../utils/notes";
import Container from "../shared/Container.astro";

interface Props {
  notes: NoteEntry[];
}

const { notes } = Astro.props;
---

<section class="content-section" aria-labelledby="knowledge-overview-heading">
  <Container>
    <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <p
          class="section-kicker text-xs font-bold tracking-[0.2em] text-indigo-700 uppercase dark:text-indigo-300"
        >
          Knowledge Overview
        </p>
        <h2
          id="knowledge-overview-heading"
          class="section-title mt-3 font-display text-3xl font-bold text-stone-950 dark:text-stone-50"
        >
          知识概览
        </h2>
      </div>
      <a
        href="/learn"
        class="inline-flex min-h-11 items-center rounded-xl px-3 text-sm font-semibold text-stone-600 hover:bg-stone-200/70 hover:text-indigo-800 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-700 dark:text-stone-300 dark:hover:bg-stone-800 dark:hover:text-indigo-200 dark:focus-visible:outline-indigo-300"
      >
        浏览全部知识 <span class="ml-2" aria-hidden="true">→</span>
      </a>
    </div>

    <div class="mt-8 grid gap-5 md:grid-cols-2">
      {
        Object.entries(DOMAINS).map(([domainId, domain], index) => {
          const domainNotes = notes.filter(({ data }) => data.domain === domainId);
          const topicCount = new Set(domainNotes.map(({ data }) => `${data.subject}/${data.topic}`))
            .size;

          return (
            <a
              href={`/learn/${domain.slug}`}
              class="material-card group relative overflow-hidden rounded-2xl border border-stone-200 bg-white/80 p-7 shadow-sm transition hover:-translate-y-0.5 hover:border-indigo-300 hover:shadow-md focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-indigo-700 motion-reduce:transform-none motion-reduce:transition-none sm:p-9 dark:border-stone-800 dark:bg-stone-900/80 dark:hover:border-indigo-800 dark:focus-visible:outline-indigo-300"
            >
              <span class="font-mono text-xs text-stone-400">
                {String(index + 1).padStart(2, "0")}
              </span>
              <p class="mt-12 text-xs font-bold tracking-[0.18em] text-indigo-700 uppercase dark:text-indigo-300">
                {domain.englishLabel}
              </p>
              <h3 class="mt-2 font-display text-3xl font-bold text-stone-950 dark:text-stone-50">
                {domain.label}
              </h3>
              <p class="mt-4 max-w-lg text-sm leading-7 text-stone-600 dark:text-stone-400">
                {domain.description}
              </p>
              <p class="mt-8 text-sm font-semibold text-stone-700 dark:text-stone-300">
                {domainNotes.length} Notes · {topicCount} Topics
              </p>
            </a>
          );
        })
      }
    </div>
  </Container>
</section>
