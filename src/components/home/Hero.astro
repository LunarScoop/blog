---
import ButtonLink from "../shared/ButtonLink.astro";
import Container from "../shared/Container.astro";

interface Props {
  noteCount: number;
  projectCount: number;
  thoughtCount: number;
}

const { noteCount, projectCount, thoughtCount } = Astro.props;
---

<section
  class="home-hero relative isolate flex min-h-[calc(100svh-4rem)] items-center overflow-hidden"
>
  <div class="home-hero-image absolute inset-0 -z-20" aria-hidden="true"></div>
  <div class="home-hero-overlay absolute inset-0 -z-10" aria-hidden="true"></div>

  <Container class="py-20 sm:py-24">
    <div class="mx-auto flex max-w-5xl flex-col items-center text-center text-white">
      <p
        class="mb-6 flex items-center gap-3 text-xs font-bold tracking-[0.24em] uppercase text-white/75"
      >
        <span class="block h-px w-9 bg-current" aria-hidden="true"></span>
        Personal Knowledge Garden
        <span class="block h-px w-9 bg-current" aria-hidden="true"></span>
      </p>
      <h1
        class="font-display text-4xl leading-[1.08] font-bold tracking-[-0.045em] text-balance sm:text-6xl lg:text-7xl"
      >
        把理解整理成可以再次抵达的知识路径喵~
      </h1>
      <p class="mt-7 max-w-2xl text-base leading-8 text-white/78 sm:text-lg sm:leading-9">
        持续记录数学、计算机、项目实践，以及那些仍在形成的思考喵~
      </p>
      <div class="mt-9 flex flex-wrap justify-center gap-3">
        <ButtonLink href="/learn" class="hero-primary-button">
          Explore Learn <span aria-hidden="true">→</span>
        </ButtonLink>
        <ButtonLink href="/projects" variant="secondary" class="hero-secondary-button">
          Projects
        </ButtonLink>
      </div>

      <dl
        class="mt-14 grid w-full max-w-2xl grid-cols-3 border-y border-white/20 bg-black/10 backdrop-blur-sm"
      >
        {
          [
            { label: "Notes", value: noteCount },
            { label: "Projects", value: projectCount },
            { label: "Thoughts", value: thoughtCount },
          ].map((item, index) => (
            <div class:list={["px-3 py-5 sm:px-6", index > 0 && "border-l border-white/20"]}>
              <dd class="font-display text-2xl font-bold text-white sm:text-3xl">
                {String(item.value).padStart(2, "0")}
              </dd>
              <dt class="mt-1 text-[0.68rem] font-semibold tracking-[0.16em] text-white/60 uppercase">
                {item.label}
              </dt>
            </div>
          ))
        }
      </dl>
    </div>
  </Container>

  <a
    href="#home-content"
    class="absolute bottom-5 left-1/2 -translate-x-1/2 rounded-lg px-3 py-2 text-xs font-semibold tracking-[0.18em] text-white/65 uppercase transition hover:text-white focus-visible:outline-2 focus-visible:outline-offset-3 focus-visible:outline-white"
  >
    Scroll <span aria-hidden="true">↓</span>
  </a>
</section>

<style>
  .home-hero-image {
    background-image: url("/images/ulbo-hero.webp");
    background-position: center;
    background-size: cover;
    transform: scale(1.01);
  }

  .home-hero-overlay {
    background:
      linear-gradient(180deg, rgb(5 10 18 / 0.52), rgb(5 10 18 / 0.34) 48%, rgb(5 10 18 / 0.7)),
      radial-gradient(circle at 50% 44%, transparent 0 25%, rgb(3 7 14 / 0.25) 75%);
  }

  :global(.hero-primary-button) {
    background: white !important;
    color: #171923 !important;
    box-shadow: 0 12px 36px rgb(0 0 0 / 0.22) !important;
  }

  :global(.hero-primary-button:hover) {
    background: #f3f4f6 !important;
  }

  :global(.hero-secondary-button) {
    border-color: rgb(255 255 255 / 0.42) !important;
    background: rgb(255 255 255 / 0.1) !important;
    color: white !important;
    backdrop-filter: blur(8px);
  }

  :global(.hero-secondary-button:hover) {
    border-color: rgb(255 255 255 / 0.72) !important;
    background: rgb(255 255 255 / 0.16) !important;
  }
</style>
