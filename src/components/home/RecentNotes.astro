---
import { getNoteHref, getSubjectConfig, getTopicLabel } from "../../config/subjects";
import type { NoteEntry } from "../../utils/notes";
import Container from "../shared/Container.astro";

interface Props {
  notes: NoteEntry[];
}

const { notes } = Astro.props;
---

<section class="content-section" aria-labelledby="recent-notes-heading">
  <Container>
    <div>
      <p
        class="section-kicker text-xs font-bold tracking-[0.2em] text-indigo-700 uppercase dark:text-indigo-300"
      >
        Recently Updated
      </p>
      <h2
        id="recent-notes-heading"
        class="section-title mt-3 font-display text-3xl font-bold text-stone-950 dark:text-stone-50"
      >
        最近更新
      </h2>
    </div>

    <ol
      class="mt-8 divide-y divide-stone-200 border-y border-stone-200 dark:divide-stone-800 dark:border-stone-800"
    >
      {
        notes.map((note, index) => {
          const updated = note.data.updated ?? note.data.created;

          return (
            <li>
              <a
                href={getNoteHref(note.id)}
                class="post-list-item group grid gap-3 py-5 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-indigo-700 sm:grid-cols-[3rem_minmax(0,1fr)_auto] sm:items-center dark:focus-visible:outline-indigo-300"
              >
                <span class="font-mono text-xs text-stone-400">
                  {String(index + 1).padStart(2, "0")}
                </span>
                <span>
                  <span class="font-display text-lg font-bold text-stone-900 group-hover:text-indigo-800 dark:text-stone-100 dark:group-hover:text-indigo-200">
                    {note.data.title}
                  </span>
                  <span class="mt-1 block text-xs text-stone-400">
                    {getSubjectConfig(note.data.subject)?.label} · {getTopicLabel(note.data.topic)}
                  </span>
                </span>
                <time datetime={updated.toISOString()} class="text-xs text-stone-400">
                  {updated.toISOString().slice(0, 10)}
                </time>
              </a>
            </li>
          );
        })
      }
    </ol>
  </Container>
</section>
