---
import { getThoughtHref } from "../../utils/routes";
import type { ThoughtEntry } from "../../utils/thoughts";

interface Props {
  thought: ThoughtEntry;
  compact?: boolean;
}

const { thought, compact = false } = Astro.props;
const formattedDate = new Intl.DateTimeFormat("zh-CN", {
  year: "numeric",
  month: "long",
  day: "numeric",
  timeZone: "UTC",
}).format(thought.data.published);
---

<article
  class="material-card group flex h-full flex-col rounded-2xl border border-stone-200 bg-white/80 p-6 shadow-sm transition hover:border-indigo-300 hover:shadow-md dark:border-stone-800 dark:bg-stone-900/80 dark:hover:border-indigo-800"
>
  <time
    datetime={thought.data.published.toISOString()}
    class="text-xs font-semibold tracking-[0.12em] text-stone-400 uppercase"
  >
    {formattedDate}
  </time>
  <h3
    class:list={[
      "mt-5 font-display font-bold text-stone-950 dark:text-stone-50",
      compact ? "text-xl" : "text-2xl",
    ]}
  >
    <a
      href={getThoughtHref(thought.id)}
      class="rounded-sm transition group-hover:text-indigo-800 focus-visible:outline-2 focus-visible:outline-offset-3 focus-visible:outline-indigo-700 dark:group-hover:text-indigo-200 dark:focus-visible:outline-indigo-300"
    >
      {thought.data.title}
    </a>
  </h3>
  <p class="mt-3 text-sm leading-7 text-stone-600 dark:text-stone-400">
    {thought.data.description}
  </p>
  <ul class="mt-auto flex flex-wrap gap-2 pt-6" aria-label="标签">
    {thought.data.tags.slice(0, 3).map((tag) => <li class="text-xs text-stone-400">#{tag}</li>)}
  </ul>
</article>
