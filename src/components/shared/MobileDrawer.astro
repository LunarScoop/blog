---
interface Props {
  id: string;
  label: string;
  title: string;
  icon: string;
  side?: "left" | "right";
}

const { id, label, title, icon, side = "left" } = Astro.props;
---

<button
  type="button"
  data-knowledge-drawer-open={id}
  aria-controls={id}
  aria-expanded="false"
  class="inline-flex min-h-11 flex-1 items-center justify-center gap-2 rounded-xl border border-stone-200 bg-white px-4 text-sm font-semibold text-stone-700 transition hover:border-indigo-300 hover:bg-indigo-50 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-700 dark:border-stone-700 dark:bg-[#1a1d28] dark:text-stone-200 dark:hover:border-indigo-700 dark:hover:bg-indigo-500/10 dark:focus-visible:outline-indigo-300"
>
  <span class="font-mono text-base text-indigo-700 dark:text-indigo-300" aria-hidden="true"
    >{icon}</span
  >
  {label}
</button>

<dialog
  id={id}
  data-knowledge-drawer
  data-side={side}
  class:list={[
    "knowledge-drawer m-0 h-dvh max-h-none w-[min(23rem,90vw)] max-w-none border-0 bg-white p-0 text-stone-950 shadow-2xl backdrop:bg-stone-950/50 backdrop:backdrop-blur-sm dark:bg-[#1a1d28] dark:text-stone-50",
    side === "left" ? "mr-auto" : "ml-auto",
  ]}
  aria-label={title}
>
  <div class="flex h-full flex-col">
    <header
      class="flex min-h-16 items-center justify-between gap-4 border-b border-stone-200 px-5 dark:border-stone-800"
    >
      <h2 class="font-display text-xl font-bold">{title}</h2>
      <button
        type="button"
        data-knowledge-drawer-close
        class="inline-flex size-10 items-center justify-center rounded-xl border border-stone-200 bg-white text-xl text-stone-700 transition hover:border-indigo-300 hover:bg-indigo-50 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-700 dark:border-stone-700 dark:bg-[#202432] dark:text-stone-200 dark:hover:border-indigo-700 dark:hover:bg-indigo-500/10 dark:focus-visible:outline-indigo-300"
        aria-label={`关闭${title}`}
      >
        <span aria-hidden="true">×</span>
      </button>
    </header>
    <div class="min-h-0 flex-1 overflow-y-auto px-5 py-6">
      <slot />
    </div>
  </div>
</dialog>

<script>
  const drawers = document.querySelectorAll<HTMLDialogElement>("[data-knowledge-drawer]");

  drawers.forEach((drawer) => {
    if (drawer.dataset.bound === "true") {
      return;
    }

    drawer.dataset.bound = "true";
    const trigger = document.querySelector<HTMLButtonElement>(
      `[data-knowledge-drawer-open="${drawer.id}"]`,
    );
    const closeButton = drawer.querySelector<HTMLButtonElement>("[data-knowledge-drawer-close]");
    const links = drawer.querySelectorAll<HTMLAnchorElement>("a");

    const closeDrawer = () => {
      if (drawer.open) {
        drawer.close();
      }
    };

    trigger?.addEventListener("click", () => {
      drawers.forEach((otherDrawer) => {
        if (otherDrawer !== drawer && otherDrawer.open) {
          otherDrawer.close();
        }
      });
      drawer.showModal();
      trigger.setAttribute("aria-expanded", "true");
      document.documentElement.classList.add("menu-open");
    });

    closeButton?.addEventListener("click", closeDrawer);
    links.forEach((link) => link.addEventListener("click", closeDrawer));

    drawer.addEventListener("click", (event) => {
      if (event.target === drawer) {
        closeDrawer();
      }
    });

    drawer.addEventListener("close", () => {
      trigger?.setAttribute("aria-expanded", "false");

      if (!Array.from(drawers).some((candidate) => candidate.open)) {
        document.documentElement.classList.remove("menu-open");
      }

      trigger?.focus();
    });
  });
</script>
