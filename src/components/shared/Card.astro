---
interface Props {
  eyebrow: string;
  title: string;
  description: string;
  href?: string;
}

const { eyebrow, title, description, href } = Astro.props;
const sharedClass =
  "material-card group relative flex h-full flex-col overflow-hidden border p-6 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-indigo-700 motion-reduce:transform-none motion-reduce:transition-none sm:p-7 dark:focus-visible:outline-indigo-300";
---

{
  href ? (
    <a href={href} class={sharedClass}>
      <span class="mb-10 block text-xs font-bold tracking-[0.2em] text-indigo-700 uppercase dark:text-indigo-300">
        {eyebrow}
      </span>
      <h2 class="font-display text-2xl font-semibold tracking-tight text-stone-950 dark:text-stone-50">
        {title}
      </h2>
      <p class="mt-3 max-w-sm text-sm leading-7 text-stone-600 dark:text-stone-400">
        {description}
      </p>
      <span
        class="mt-7 inline-flex items-center gap-2 text-sm font-semibold text-stone-800 dark:text-stone-200"
        aria-hidden="true"
      >
        进入浏览
        <span class="transition-transform duration-200 group-hover:translate-x-1 motion-reduce:transform-none">
          →
        </span>
      </span>
    </a>
  ) : (
    <article class={sharedClass}>
      <span class="mb-10 block text-xs font-bold tracking-[0.2em] text-indigo-700 uppercase dark:text-indigo-300">
        {eyebrow}
      </span>
      <h2 class="font-display text-2xl font-semibold tracking-tight text-stone-950 dark:text-stone-50">
        {title}
      </h2>
      <p class="mt-3 max-w-sm text-sm leading-7 text-stone-600 dark:text-stone-400">
        {description}
      </p>
    </article>
  )
}
