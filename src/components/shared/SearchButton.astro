---
const isActive = Astro.url.pathname === "/search";
---

<a
  href="/search"
  class:list={[
    "header-control inline-flex size-10 items-center justify-center rounded-xl border transition focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-700 motion-reduce:transition-none dark:focus-visible:outline-indigo-300",
    isActive
      ? "border-indigo-200 bg-indigo-50 text-indigo-700 dark:border-indigo-800 dark:bg-indigo-500/15 dark:text-indigo-300"
      : "border-transparent text-stone-700 dark:text-stone-200",
  ]}
  aria-label="搜索"
  aria-current={isActive ? "page" : undefined}
>
  <svg
    viewBox="0 0 24 24"
    class="size-5"
    fill="none"
    stroke="currentColor"
    stroke-width="1.8"
    aria-hidden="true"
  >
    <circle cx="11" cy="11" r="6.5"></circle>
    <path d="m16 16 4 4"></path>
  </svg>
</a>
