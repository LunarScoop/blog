---
import type { ProjectEntry } from "../../utils/projects";
import { getProjectHref } from "../../utils/routes";

interface Props {
  project: ProjectEntry;
  compact?: boolean;
}

const { project, compact = false } = Astro.props;
const statusLabels = {
  planning: "规划中",
  building: "构建中",
  completed: "已完成",
  archived: "已归档",
} as const;
---

<article
  class="material-card group flex h-full flex-col rounded-2xl border border-stone-200 bg-white/80 p-6 shadow-sm transition hover:-translate-y-0.5 hover:border-indigo-300 hover:shadow-md motion-reduce:transform-none motion-reduce:transition-none dark:border-stone-800 dark:bg-stone-900/80 dark:hover:border-indigo-800"
>
  <div class="flex items-center justify-between gap-4">
    <span
      class="rounded-md border border-indigo-200 bg-indigo-50 px-3 py-1 text-xs font-semibold text-indigo-700 dark:border-indigo-800 dark:bg-indigo-500/15 dark:text-indigo-300"
    >
      {statusLabels[project.data.status]}
    </span>
    {
      project.data.featured && (
        <span class="text-xs font-bold text-amber-600 dark:text-amber-300">Featured</span>
      )
    }
  </div>
  <h3
    class:list={[
      "mt-6 font-display font-bold text-stone-950 dark:text-stone-50",
      compact ? "text-xl" : "text-2xl",
    ]}
  >
    <a
      href={getProjectHref(project.id)}
      class="rounded-sm transition group-hover:text-indigo-800 focus-visible:outline-2 focus-visible:outline-offset-3 focus-visible:outline-indigo-700 dark:group-hover:text-indigo-200 dark:focus-visible:outline-indigo-300"
    >
      {project.data.title}
    </a>
  </h3>
  <p class="mt-3 text-sm leading-7 text-stone-600 dark:text-stone-400">
    {project.data.description}
  </p>
  <ul class="mt-5 flex flex-wrap gap-2" aria-label="技术栈">
    {
      project.data.technologies
        .slice(0, compact ? 3 : 5)
        .map((technology) => (
          <li class="tag-chip px-2 py-1 font-mono text-[0.7rem]">{technology}</li>
        ))
    }
  </ul>
  <a
    href={getProjectHref(project.id)}
    class="mt-auto inline-flex min-h-11 items-center pt-7 text-sm font-semibold text-stone-700 transition hover:text-indigo-800 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-700 dark:text-stone-300 dark:hover:text-indigo-200 dark:focus-visible:outline-indigo-300"
    aria-label={`查看项目：${project.data.title}`}
  >
    查看项目 <span class="ml-2" aria-hidden="true">→</span>
  </a>
</article>
