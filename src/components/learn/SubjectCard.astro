---
import { getSubjectConfig, getSubjectHref, getTopicLabel } from "../../config/subjects";
import { groupNotesByTopic } from "../../utils/knowledge";
import type { NoteEntry } from "../../utils/notes";

interface Props {
  subjectId: string;
  notes: NoteEntry[];
  index: number;
}

const { subjectId, notes, index } = Astro.props;
const subject = getSubjectConfig(subjectId);
const topics = groupNotesByTopic(notes);
---

<a
  href={getSubjectHref(subjectId)}
  class="material-card group flex h-full flex-col rounded-2xl border border-stone-200 bg-white/80 p-6 shadow-sm transition hover:-translate-y-0.5 hover:border-indigo-300 hover:shadow-md focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-indigo-700 motion-reduce:transform-none motion-reduce:transition-none dark:border-stone-800 dark:bg-stone-900/80 dark:hover:border-indigo-800 dark:focus-visible:outline-indigo-300"
>
  <div class="flex items-start justify-between gap-5">
    <span class="font-mono text-xs text-stone-400">{String(index + 1).padStart(2, "0")}</span>
    <span class="tag-chip px-2.5 py-1 text-xs font-semibold">
      {notes.length} Notes
    </span>
  </div>
  <p
    class="mt-8 text-xs font-bold tracking-[0.16em] text-indigo-700 uppercase dark:text-indigo-300"
  >
    {subject?.englishLabel ?? subjectId}
  </p>
  <h2 class="mt-2 font-display text-2xl font-bold text-stone-950 dark:text-stone-50">
    {subject?.label ?? subjectId}
  </h2>
  <p class="mt-3 text-sm leading-7 text-stone-600 dark:text-stone-400">
    {subject?.description ?? "这个学科的知识结构正在整理中喵~"}
  </p>
  <div class="mt-6 flex flex-wrap gap-2">
    {
      topics.length > 0 ? (
        topics
          .slice(0, 3)
          .map(({ topic }) => (
            <span class="tag-chip px-2 py-1 text-xs">{getTopicLabel(topic)}</span>
          ))
      ) : (
        <span class="text-xs text-stone-400">等待第一篇笔记喵~</span>
      )
    }
  </div>
  <span
    class="mt-auto pt-8 text-sm font-semibold text-stone-800 group-hover:text-indigo-800 dark:text-stone-200 dark:group-hover:text-indigo-200"
  >
    查看学科 <span aria-hidden="true">→</span>
  </span>
</a>
