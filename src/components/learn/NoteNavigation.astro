---
import { getNoteHref } from "../../config/subjects";
import type { NoteEntry } from "../../utils/notes";

interface Props {
  previous?: NoteEntry;
  next?: NoteEntry;
}

const { previous, next } = Astro.props;
---

{
  (previous || next) && (
    <nav class="grid gap-3 sm:grid-cols-2" aria-label="上一篇与下一篇">
      {previous ? (
        <a
          href={getNoteHref(previous.id)}
          class="material-card group rounded-xl border border-stone-200 bg-white p-5 shadow-sm transition hover:-translate-y-0.5 hover:border-indigo-300 hover:shadow-md focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-700 motion-reduce:transform-none motion-reduce:transition-none dark:border-stone-800 dark:bg-stone-900 dark:hover:border-indigo-800 dark:focus-visible:outline-indigo-300"
        >
          <span class="text-xs font-bold tracking-[0.16em] text-stone-400 uppercase">
            ← 上一知识
          </span>
          <span class="mt-2 block font-display text-lg font-bold text-stone-900 group-hover:text-indigo-800 dark:text-stone-100 dark:group-hover:text-indigo-200">
            {previous.data.title}
          </span>
        </a>
      ) : (
        <span class="hidden sm:block" aria-hidden="true" />
      )}

      {next && (
        <a
          href={getNoteHref(next.id)}
          class="group rounded-xl border border-stone-200 bg-white p-5 text-right shadow-sm transition hover:-translate-y-0.5 hover:border-indigo-300 hover:shadow-md focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-700 motion-reduce:transform-none motion-reduce:transition-none dark:border-stone-800 dark:bg-stone-900 dark:hover:border-indigo-800 dark:focus-visible:outline-indigo-300"
        >
          <span class="text-xs font-bold tracking-[0.16em] text-stone-400 uppercase">
            下一知识 →
          </span>
          <span class="mt-2 block font-display text-lg font-bold text-stone-900 group-hover:text-indigo-800 dark:text-stone-100 dark:group-hover:text-indigo-200">
            {next.data.title}
          </span>
        </a>
      )}
    </nav>
  )
}
