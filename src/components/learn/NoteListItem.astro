---
import { getNoteHref, getTopicLabel } from "../../config/subjects";
import type { NoteEntry } from "../../utils/notes";

interface Props {
  note: NoteEntry;
  index: number;
}

const { note, index } = Astro.props;
const updated = note.data.updated ?? note.data.created;
const formattedDate = new Intl.DateTimeFormat("zh-CN", {
  year: "numeric",
  month: "2-digit",
  day: "2-digit",
  timeZone: "UTC",
}).format(updated);

const statusLabels = {
  todo: "待开始",
  learning: "学习中",
  reviewing: "复习中",
  completed: "已完成",
} as const;
---

<li>
  <a
    href={getNoteHref(note.id)}
    class="material-card group grid gap-4 rounded-xl border border-stone-200 bg-white p-5 transition hover:border-indigo-300 hover:shadow-sm focus-visible:outline-2 focus-visible:outline-offset-3 focus-visible:outline-indigo-700 sm:grid-cols-[2.5rem_minmax(0,1fr)_auto] sm:items-center dark:border-stone-800 dark:bg-stone-900 dark:hover:border-indigo-800 dark:focus-visible:outline-indigo-300"
  >
    <span class="font-mono text-xs text-stone-400">{String(index + 1).padStart(2, "0")}</span>
    <span class="min-w-0">
      <span
        class="block font-display text-lg font-bold text-stone-900 group-hover:text-indigo-800 dark:text-stone-100 dark:group-hover:text-indigo-200"
      >
        {note.data.title}
      </span>
      <span class="mt-1 block text-sm leading-6 text-stone-500 dark:text-stone-400">
        {note.data.description}
      </span>
    </span>
    <span class="flex flex-wrap items-center gap-2 text-xs text-stone-400 sm:justify-end">
      <span>{getTopicLabel(note.data.topic)}</span>
      <span aria-hidden="true">·</span>
      <span>{statusLabels[note.data.status]}</span>
      <span aria-hidden="true">·</span>
      <time datetime={updated.toISOString()}>{formattedDate}</time>
    </span>
  </a>
</li>
