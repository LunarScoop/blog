---
import { getNoteHref, getSubjectConfig, getTopicLabel } from "../../config/subjects";
import type { NoteEntry } from "../../utils/notes";

interface Props {
  notes: NoteEntry[];
}

const { notes } = Astro.props;
---

<section class="mt-10" aria-labelledby="related-notes-heading">
  <div class="flex items-end justify-between gap-4">
    <div>
      <p class="text-xs font-bold tracking-[0.18em] text-indigo-700 uppercase dark:text-indigo-300">
        Keep exploring
      </p>
      <h2
        id="related-notes-heading"
        class="mt-2 font-display text-2xl font-bold text-stone-950 dark:text-stone-50"
      >
        Related Notes
      </h2>
    </div>
    <span class="text-xs text-stone-400">{notes.length} 篇</span>
  </div>

  {
    notes.length > 0 ? (
      <div class="mt-5 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {notes.map((note) => (
          <a
            href={getNoteHref(note.id)}
            class="material-card group rounded-xl border border-stone-200 bg-white p-4 transition hover:border-indigo-300 hover:shadow-sm focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-700 dark:border-stone-800 dark:bg-stone-900 dark:hover:border-indigo-800 dark:focus-visible:outline-indigo-300"
          >
            <span class="text-xs text-stone-400">
              {getSubjectConfig(note.data.subject)?.label} · {getTopicLabel(note.data.topic)}
            </span>
            <span class="mt-2 block font-display font-bold text-stone-900 group-hover:text-indigo-800 dark:text-stone-100 dark:group-hover:text-indigo-200">
              {note.data.title}
            </span>
          </a>
        ))}
      </div>
    ) : (
      <p class="mt-5 rounded-xl border border-dashed border-stone-300 px-4 py-5 text-sm text-stone-500 dark:border-stone-700 dark:text-stone-400">
        暂时没有匹配的关联笔记，后续内容增加后会自动出现在这里喵~
      </p>
    )
  }
</section>
