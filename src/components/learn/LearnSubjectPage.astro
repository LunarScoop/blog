---
import {
  getDomainConfig,
  getSubjectConfig,
  getTopicLabel,
  type SubjectId,
} from "../../config/subjects";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { groupNotesByTopic } from "../../utils/knowledge";
import type { NoteEntry } from "../../utils/notes";
import Container from "../shared/Container.astro";
import NoteListItem from "./NoteListItem.astro";

interface Props {
  subjectId: SubjectId;
  notes: NoteEntry[];
}

const { subjectId, notes } = Astro.props;
const subject = getSubjectConfig(subjectId);
const domain = getDomainConfig(subject.domain);
const topicGroups = groupNotesByTopic(notes);
---

<BaseLayout title={subject.label} description={subject.description}>
  <section class="page-section">
    <Container>
      <nav
        class="flex flex-wrap items-center gap-2 text-sm text-stone-500 dark:text-stone-400"
        aria-label="面包屑"
      >
        <a
          href="/learn"
          class="rounded-sm hover:text-indigo-700 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-700 dark:hover:text-indigo-300 dark:focus-visible:outline-indigo-300"
        >
          Learn
        </a>
        <span aria-hidden="true">/</span>
        <a
          href={`/learn/${domain.slug}`}
          class="rounded-sm hover:text-indigo-700 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-700 dark:hover:text-indigo-300 dark:focus-visible:outline-indigo-300"
        >
          {domain.label}
        </a>
        <span aria-hidden="true">/</span>
        <span>{subject.label}</span>
      </nav>

      <header class="page-header mt-10">
        <p
          class="page-kicker text-xs font-bold tracking-[0.22em] text-indigo-700 uppercase dark:text-indigo-300"
        >
          {subject.englishLabel}
        </p>
        <h1
          class="page-title mt-4 font-display text-4xl font-bold tracking-[-0.035em] text-stone-950 sm:text-6xl dark:text-stone-50"
        >
          {subject.label}
        </h1>
        <p
          class="page-description mt-5 text-base leading-8 text-stone-600 sm:text-lg dark:text-stone-300"
        >
          {subject.description}
        </p>
      </header>

      {
        topicGroups.length > 0 ? (
          <div class="mt-14 space-y-14">
            {topicGroups.map(({ topic, notes: topicNotes }, topicIndex) => (
              <section aria-labelledby={`topic-${topic}`}>
                <div class="flex items-end justify-between gap-5 border-b border-stone-200 pb-4 dark:border-stone-800">
                  <div class="flex items-center gap-4">
                    <span class="font-mono text-xs text-stone-400">
                      {String(topicIndex + 1).padStart(2, "0")}
                    </span>
                    <h2
                      id={`topic-${topic}`}
                      class="font-display text-2xl font-bold text-stone-950 dark:text-stone-50"
                    >
                      {getTopicLabel(topic)}
                    </h2>
                  </div>
                  <span class="text-xs text-stone-400">{topicNotes.length} Notes</span>
                </div>
                <ol class="mt-5 space-y-3">
                  {topicNotes.map((note, index) => (
                    <NoteListItem note={note} index={index} />
                  ))}
                </ol>
              </section>
            ))}
          </div>
        ) : (
          <div class="mt-14 rounded-2xl border border-dashed border-stone-300 px-6 py-12 text-center dark:border-stone-700">
            <h2 class="font-display text-2xl font-bold text-stone-900 dark:text-stone-100">
              这个学科正在等待第一篇笔记喵~
            </h2>
            <p class="mt-3 text-sm leading-7 text-stone-500 dark:text-stone-400">
              页面和章节顺序已经准备好，新增内容后会自动出现在这里喵~
            </p>
          </div>
        )
      }
    </Container>
  </section>
</BaseLayout>
