---
import type { NoteEntry } from "../../utils/notes";

interface Props {
  data: NoteEntry["data"];
}

const { data } = Astro.props;

const difficultyLabels = {
  easy: "Easy · 入门",
  medium: "Medium · 进阶",
  hard: "Hard · 挑战",
} as const;

const statusLabels = {
  todo: "待开始",
  learning: "学习中",
  reviewing: "复习中",
  completed: "已完成",
} as const;

const updated = data.updated ?? data.created;
const formattedDate = new Intl.DateTimeFormat("zh-CN", {
  year: "numeric",
  month: "long",
  day: "numeric",
  timeZone: "UTC",
}).format(updated);
---

<div class="mt-7 flex flex-wrap items-center gap-2.5" aria-label="笔记元信息">
  {
    data.difficulty && (
      <span class="tag-chip inline-flex min-h-8 items-center px-3 text-xs font-semibold">
        {difficultyLabels[data.difficulty]}
      </span>
    )
  }
  <span
    class="inline-flex min-h-8 items-center rounded-md border border-indigo-200 bg-indigo-50 px-3 text-xs font-semibold text-indigo-700 dark:border-indigo-800 dark:bg-indigo-500/15 dark:text-indigo-300"
  >
    {statusLabels[data.status]}
  </span>
  <span class="text-sm text-stone-500 dark:text-stone-400">更新于 {formattedDate}</span>
</div>

{
  data.tags.length > 0 && (
    <ul class="mt-4 flex flex-wrap gap-2" aria-label="标签">
      {data.tags.map((tag) => (
        <li class="tag-chip px-2.5 py-1 text-xs">#{tag}</li>
      ))}
    </ul>
  )
}
