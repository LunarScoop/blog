---
import { getSubjectConfig, getTopicLabel, getNoteHref } from "../../config/subjects";
import { groupNotesByTopic } from "../../utils/knowledge";
import type { NoteEntry } from "../../utils/notes";

interface Props {
  notes: NoteEntry[];
  currentNote: NoteEntry;
}

const { notes, currentNote } = Astro.props;
const subject = getSubjectConfig(currentNote.data.subject);
const subjectNotes = notes.filter(({ data }) => data.subject === currentNote.data.subject);
const topicGroups = groupNotesByTopic(subjectNotes);
---

<section aria-label="课程知识树">
  <header class="border-b border-stone-200 px-1 pb-5 dark:border-stone-800">
    <p class="text-xs font-bold tracking-[0.18em] text-indigo-700 uppercase dark:text-indigo-300">
      {subject?.englishLabel ?? currentNote.data.subject}
    </p>
    <h2 class="mt-2 font-display text-xl font-bold text-stone-950 dark:text-stone-50">
      {subject?.label ?? currentNote.data.subject}
    </h2>
    <p class="mt-2 text-sm text-stone-500 dark:text-stone-400">
      {subjectNotes.length} 篇知识笔记喵~
    </p>
  </header>

  <nav class="mt-4" aria-label={`${subject?.label ?? "当前学科"}章节`}>
    {
      topicGroups.map(({ topic, notes: topicNotes }) => {
        const isCurrentTopic = topic === currentNote.data.topic;

        return (
          <details
            class="knowledge-tree-group border-b border-stone-200/80 py-2 dark:border-stone-800/80"
            open={isCurrentTopic}
          >
            <summary
              class:list={[
                "flex min-h-11 cursor-pointer list-none items-center justify-between gap-3 rounded-lg px-2.5 text-sm font-semibold transition focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-700 dark:focus-visible:outline-indigo-300",
                isCurrentTopic
                  ? "bg-indigo-50 text-indigo-700 dark:bg-indigo-500/15 dark:text-indigo-200"
                  : "text-stone-700 hover:bg-stone-100 dark:text-stone-300 dark:hover:bg-stone-800",
              ]}
            >
              <span class="flex min-w-0 items-center gap-2">
                <span class="knowledge-tree-chevron text-xs text-stone-400" aria-hidden="true">
                  ›
                </span>
                <span class="truncate">{getTopicLabel(topic)}</span>
              </span>
              <span class="font-mono text-[0.68rem] text-stone-400">{topicNotes.length}</span>
            </summary>

            <ol class="mt-1 space-y-1 border-l border-stone-200 py-1 pl-3 dark:border-stone-700">
              {topicNotes.map((note) => {
                const isCurrentNote = note.id === currentNote.id;

                return (
                  <li>
                    <a
                      href={getNoteHref(note.id)}
                      aria-current={isCurrentNote ? "page" : undefined}
                      class:list={[
                        "flex min-h-10 items-center justify-between gap-2 rounded-lg px-3 py-2 text-sm leading-5 transition focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-700 dark:focus-visible:outline-indigo-300",
                        isCurrentNote
                          ? "bg-indigo-600 font-semibold text-white dark:bg-indigo-500 dark:text-white"
                          : "text-stone-600 hover:bg-stone-100 hover:text-stone-950 dark:text-stone-400 dark:hover:bg-stone-800 dark:hover:text-stone-50",
                      ]}
                    >
                      <span>{note.data.title}</span>
                      {note.data.draft && <span class="text-[0.65rem] opacity-70">草稿</span>}
                    </a>
                  </li>
                );
              })}
            </ol>
          </details>
        );
      })
    }
  </nav>
</section>
