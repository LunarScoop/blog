---
import { getDomainConfig, getSubjectsForDomain, type DomainId } from "../../config/subjects";
import BaseLayout from "../../layouts/BaseLayout.astro";
import type { NoteEntry } from "../../utils/notes";
import Container from "../shared/Container.astro";
import SubjectCard from "./SubjectCard.astro";

interface Props {
  domainId: DomainId;
  notes: NoteEntry[];
}

const { domainId, notes } = Astro.props;
const domain = getDomainConfig(domainId);
const subjects = getSubjectsForDomain(domainId);
---

<BaseLayout title={domain.label} description={`${domain.label}知识领域与学科导航喵~`}>
  <section class="page-section">
    <Container>
      <nav class="text-sm text-stone-500 dark:text-stone-400" aria-label="面包屑">
        <a
          href="/learn"
          class="rounded-sm hover:text-indigo-700 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-700 dark:hover:text-indigo-300 dark:focus-visible:outline-indigo-300"
        >
          Learn
        </a>
        <span class="mx-2" aria-hidden="true">/</span>
        <span>{domain.label}</span>
      </nav>

      <header class="page-header mt-10">
        <p
          class="page-kicker text-xs font-bold tracking-[0.22em] text-indigo-700 uppercase dark:text-indigo-300"
        >
          {domain.englishLabel}
        </p>
        <h1
          class="page-title mt-4 font-display text-4xl font-bold tracking-[-0.035em] text-stone-950 sm:text-6xl dark:text-stone-50"
        >
          {domain.label}
        </h1>
        <p
          class="page-description mt-5 text-base leading-8 text-stone-600 sm:text-lg dark:text-stone-300"
        >
          {domain.description}
        </p>
        <p class="mt-4 text-sm text-stone-500 dark:text-stone-400">
          {subjects.length} 个学科 · {notes.length} 篇公开笔记喵~
        </p>
      </header>

      <div class="mt-12 grid gap-5 md:grid-cols-2">
        {
          subjects.map((subjectId, index) => (
            <SubjectCard
              subjectId={subjectId}
              notes={notes.filter(({ data }) => data.subject === subjectId)}
              index={index}
            />
          ))
        }
      </div>
    </Container>
  </section>
</BaseLayout>
