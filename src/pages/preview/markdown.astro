---
import { getEntry, render } from "astro:content";
import MarkdownContent from "../../components/markdown/MarkdownContent.astro";
import Container from "../../components/shared/Container.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";

const markdownEntry = await getEntry("notes", "mathematics/calculus/limits/lhopital-rule");
const mdxEntry = await getEntry(
  "notes",
  "computer-science/data-structures/complexity/time-complexity",
);

if (!markdownEntry || !mdxEntry) {
  throw new Error("阶段三的 Markdown 或 MDX 验证内容缺失喵~");
}

const { Content: MarkdownNote } = await render(markdownEntry);
const { Content: MdxNote } = await render(mdxEntry);
---

<BaseLayout
  title="Markdown 渲染验证"
  description="用于验证阶段三 Markdown 与 MDX 渲染能力的内部页面喵~"
  noindex
>
  <Container class="py-12 sm:py-16">
    <div class="mx-auto max-w-4xl space-y-16">
      <header
        class="rounded-2xl border border-stone-200 bg-white/80 p-6 dark:border-stone-800 dark:bg-stone-900/80"
      >
        <p
          class="text-sm font-semibold tracking-[0.16em] text-indigo-700 uppercase dark:text-indigo-300"
        >
          Phase 3 Preview
        </p>
        <h1 class="mt-2 font-display text-3xl font-bold text-stone-950 dark:text-stone-50">
          Markdown 与 MDX 渲染验证
        </h1>
        <p class="mt-3 leading-7 text-stone-600 dark:text-stone-300">
          此页面仅用于开发阶段验收，不参与站点导航与搜索索引喵~
        </p>
      </header>

      <article
        class="rounded-2xl border border-stone-200 bg-white p-6 shadow-sm sm:p-10 dark:border-stone-800 dark:bg-stone-900"
        data-fixture="markdown"
      >
        <p
          class="text-xs font-bold tracking-[0.16em] text-indigo-700 uppercase dark:text-indigo-300"
        >
          Markdown
        </p>
        <h2 class="mt-2 mb-8 font-display text-3xl font-bold text-stone-950 dark:text-stone-50">
          {markdownEntry.data.title}
        </h2>
        <MarkdownContent>
          <MarkdownNote />
        </MarkdownContent>
      </article>

      <article
        class="rounded-2xl border border-stone-200 bg-white p-6 shadow-sm sm:p-10 dark:border-stone-800 dark:bg-stone-900"
        data-fixture="mdx"
      >
        <p
          class="text-xs font-bold tracking-[0.16em] text-indigo-700 uppercase dark:text-indigo-300"
        >
          MDX
        </p>
        <h2 class="mt-2 mb-8 font-display text-3xl font-bold text-stone-950 dark:text-stone-50">
          {mdxEntry.data.title}
        </h2>
        <MarkdownContent>
          <MdxNote />
        </MarkdownContent>
      </article>
    </div>
  </Container>
</BaseLayout>
