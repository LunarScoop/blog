---
import Container from "../components/shared/Container.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Search" description="搜索知识笔记、项目实践与随想内容喵~" noindex>
  <section class="page-section">
    <Container>
      <div class="mx-auto max-w-3xl">
        <p
          class="page-kicker text-xs font-bold tracking-[0.22em] text-indigo-700 uppercase dark:text-indigo-300"
        >
          Search
        </p>
        <h1
          class="page-title mt-5 font-display text-4xl font-semibold tracking-[-0.03em] text-stone-950 sm:text-6xl dark:text-stone-50"
        >
          在知识花园里寻找线索喵~
        </h1>
        <p class="mt-5 text-base leading-8 text-stone-600 sm:text-lg dark:text-stone-400">
          搜索范围包含知识笔记、项目实践与随想正文，导航和页脚不会干扰结果喵~
        </p>

        <form class="mt-10" role="search" data-search-form>
          <label for="site-search" class="sr-only">输入搜索关键词</label>
          <div
            class="material-surface flex items-center gap-3 rounded-xl p-2 focus-within:border-indigo-600 focus-within:ring-3 focus-within:ring-indigo-600/15 dark:focus-within:border-indigo-400"
          >
            <svg
              viewBox="0 0 24 24"
              class="ml-3 size-5 shrink-0 text-stone-400"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              aria-hidden="true"
            >
              <circle cx="11" cy="11" r="6.5"></circle>
              <path d="m16 16 4 4"></path>
            </svg>
            <input
              id="site-search"
              name="q"
              type="search"
              autocomplete="off"
              enterkeyhint="search"
              placeholder="试试搜索：极限、TCP、虚拟内存"
              class="min-h-12 min-w-0 flex-1 bg-transparent px-1 text-base text-stone-950 outline-none placeholder:text-stone-400 dark:text-stone-50"
              data-search-input
            />
            <button
              type="submit"
              class="inline-flex min-h-11 items-center rounded-xl bg-indigo-600 px-5 text-sm font-semibold text-white transition hover:bg-indigo-700 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-700 dark:bg-indigo-500 dark:text-white dark:hover:bg-indigo-400 dark:focus-visible:outline-indigo-300"
            >
              搜索
            </button>
          </div>
        </form>

        <p
          class="mt-5 min-h-6 text-sm text-stone-500 dark:text-stone-400"
          role="status"
          aria-live="polite"
          data-search-status
        >
          输入关键词开始搜索喵~
        </p>

        <ol class="mt-5 space-y-4" data-search-results></ol>

        <template data-search-result-template>
          <li>
            <article
              class="material-card rounded-2xl border border-stone-200 bg-white p-6 shadow-sm transition hover:border-indigo-300 dark:border-stone-800 dark:bg-stone-900 dark:hover:border-indigo-800"
            >
              <div class="flex flex-wrap items-center gap-3">
                <span class="tag-chip px-2.5 py-1 text-xs font-semibold" data-result-type></span>
                <span class="text-xs text-stone-400" data-result-section></span>
              </div>
              <h2
                class="section-title mt-4 font-display text-2xl font-bold text-stone-950 dark:text-stone-50"
              >
                <a
                  class="rounded-sm transition hover:text-indigo-800 focus-visible:outline-2 focus-visible:outline-offset-3 focus-visible:outline-indigo-700 dark:hover:text-indigo-200 dark:focus-visible:outline-indigo-300"
                  data-result-link></a>
              </h2>
              <p
                class="mt-3 text-sm leading-7 text-stone-600 dark:text-stone-400"
                data-result-excerpt
              >
              </p>
            </article>
          </li>
        </template>
      </div>
    </Container>
  </section>
</BaseLayout>

<script>
  interface PagefindResultData {
    url: string;
    excerpt: string;
    meta: Record<string, string>;
  }

  interface PagefindResult {
    id: string;
    data: () => Promise<PagefindResultData>;
  }

  interface PagefindSearchResponse {
    results: PagefindResult[];
  }

  interface PagefindApi {
    search: (query: string) => Promise<PagefindSearchResponse>;
  }

  const form = document.querySelector<HTMLFormElement>("[data-search-form]");
  const input = document.querySelector<HTMLInputElement>("[data-search-input]");
  const status = document.querySelector<HTMLElement>("[data-search-status]");
  const results = document.querySelector<HTMLOListElement>("[data-search-results]");
  const template = document.querySelector<HTMLTemplateElement>("[data-search-result-template]");
  const pagefindPath = "/pagefind/pagefind.js";
  let pagefindPromise: Promise<PagefindApi> | undefined;
  let requestId = 0;
  let debounceTimer = 0;

  const loadPagefind = () => {
    pagefindPromise ??= import(/* @vite-ignore */ pagefindPath) as Promise<PagefindApi>;
    return pagefindPromise;
  };

  const setStatus = (message: string) => {
    if (status) {
      status.textContent = message;
    }
  };

  const renderResult = (data: PagefindResultData) => {
    const fragment = template?.content.cloneNode(true) as DocumentFragment | undefined;

    if (!fragment) {
      return undefined;
    }

    const link = fragment.querySelector<HTMLAnchorElement>("[data-result-link]");
    const excerpt = fragment.querySelector<HTMLElement>("[data-result-excerpt]");
    const type = fragment.querySelector<HTMLElement>("[data-result-type]");
    const section = fragment.querySelector<HTMLElement>("[data-result-section]");

    if (link) {
      link.href = data.url;
      link.textContent = data.meta.title || "未命名内容";
    }

    if (excerpt) {
      excerpt.innerHTML = data.excerpt;
    }

    if (type) {
      type.textContent = data.meta.type || "Content";
    }

    if (section) {
      section.textContent = data.meta.section || "";
      section.hidden = !data.meta.section;
    }

    return fragment;
  };

  const search = async (query: string) => {
    const normalizedQuery = query.trim();
    const currentRequestId = ++requestId;

    if (!results) {
      return;
    }

    results.replaceChildren();

    if (!normalizedQuery) {
      setStatus("输入关键词开始搜索喵~");
      return;
    }

    setStatus(`正在搜索“${normalizedQuery}”喵~`);

    try {
      const pagefind = await loadPagefind();
      const response = await pagefind.search(normalizedQuery);
      const data = await Promise.all(response.results.slice(0, 20).map((result) => result.data()));

      if (currentRequestId !== requestId) {
        return;
      }

      data.forEach((item) => {
        const result = renderResult(item);

        if (result) {
          results.append(result);
        }
      });

      setStatus(
        data.length > 0
          ? `找到 ${response.results.length} 条与“${normalizedQuery}”相关的内容喵~`
          : `没有找到与“${normalizedQuery}”相关的内容，换个关键词试试吧喵~`,
      );
    } catch (error) {
      console.error("Pagefind 搜索加载失败喵~", error);
      setStatus("搜索索引暂时无法加载，请在完成生产构建后重试喵~");
    }
  };

  const updateUrl = (query: string) => {
    const url = new URL(window.location.href);

    if (query.trim()) {
      url.searchParams.set("q", query.trim());
    } else {
      url.searchParams.delete("q");
    }

    window.history.replaceState({}, "", url);
  };

  form?.addEventListener("submit", (event) => {
    event.preventDefault();
    const query = input?.value ?? "";
    window.clearTimeout(debounceTimer);
    updateUrl(query);
    void search(query);
  });

  input?.addEventListener("input", () => {
    const query = input.value;
    window.clearTimeout(debounceTimer);
    debounceTimer = window.setTimeout(() => {
      updateUrl(query);
      void search(query);
    }, 250);
  });

  const initialQuery = new URLSearchParams(window.location.search).get("q") ?? "";

  if (input && initialQuery) {
    input.value = initialQuery;
    void search(initialQuery);
  }
</script>
