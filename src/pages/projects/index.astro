---
import ArchiveCard from '../../components/ArchiveCard.astro';
import HeroHeader from '../../components/HeroHeader.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { heroConfig, locale, siteTitle } from '../../config';
import PageShell from '../../layouts/PageShell.astro';
import { getProjects } from '../../lib/content/projects';

const projects = await getProjects();
const siteURL = Astro.site ?? Astro.url;
const projectsHero = heroConfig.projects;
const description = "Things I've built and explored.";
const collectionSchema = {
	'@context': 'https://schema.org',
	'@type': 'CollectionPage',
	name: `Projects | ${siteTitle}`,
	description,
	url: new URL('/projects/', siteURL).toString(),
	inLanguage: locale,
	mainEntity: {
		'@type': 'ItemList',
		itemListElement: projects.map((project, index) => ({
			'@type': 'ListItem',
			position: index + 1,
			name: project.data.title,
			url: new URL(`/projects/${project.id}/`, siteURL).toString(),
		})),
	},
};
---

<PageShell
	title={`Projects | ${siteTitle}`}
	{description}
	schema={collectionSchema}
	transparentHeader={true}
>
	<HeroHeader
		text={projectsHero.text}
		subtitle={projectsHero.subtitle}
		backgroundImage={projectsHero.backgroundImage}
		compact={true}
	/>

	<ArchiveCard variant="blog" number="01" title="Projects" intro={description} minHeight={true}>
		{projects.length > 0 ? (
			<div class="projects-list">
				{projects.map((project) => <ProjectCard {project} />)}
			</div>
		) : (
			<p class="empty-state">No public projects yet.</p>
		)}
	</ArchiveCard>
</PageShell>

<style>
	.projects-list { display: grid; gap: 1em; }
	.empty-state { margin: 2em 0; color: var(--color-text-secondary); text-align: center; }
</style>
