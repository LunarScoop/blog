---
import { type CollectionEntry, render } from 'astro:content';
import ProjectPost from '../../layouts/ProjectPost.astro';
import { getProjects } from '../../lib/content/projects';
import { extractSeoDescription } from '../../lib/content/text';

export async function getStaticPaths() {
	const projects = await getProjects();
	return projects.map((project) => ({
		params: { slug: project.id },
		props: project,
	}));
}

type Props = CollectionEntry<'projects'>;
const project = Astro.props as Props;
const { Content, headings } = await render(project);
const seoDescription = (
	project.data.description.trim() ||
	extractSeoDescription(project.body ?? '') ||
	project.data.title
).trim();
const body = project.body ?? '';
const hasMath = /\$\$[\s\S]*?\$\$|\\\([\s\S]*?\\\)|\\\[[\s\S]*?\\\]|\$[^$\n]+\$|\\begin\{[a-zA-Z*]+\}/.test(body);
const wordCount = body.replace(/[#*`~>\[\]\(\)\-\!\s]/g, '').length;
const readingTime = Math.ceil(wordCount / 400);
---

<ProjectPost
	{project}
	{headings}
	{wordCount}
	{readingTime}
	{seoDescription}
	loadKatexStyles={hasMath}
>
	<Content />
</ProjectPost>
