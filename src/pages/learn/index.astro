---
import SubjectCard from "../../components/learn/SubjectCard.astro";
import Container from "../../components/shared/Container.astro";
import { DOMAINS, getSubjectsForDomain } from "../../config/subjects";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getNotes } from "../../utils/notes";

const notes = await getNotes();
---

<BaseLayout title="Learn" description="按学科与主题组织的数学、计算机学习笔记喵~">
  <section class="page-section">
    <Container>
      <div class="page-header">
        <p
          class="page-kicker text-xs font-bold tracking-[0.22em] text-indigo-700 uppercase dark:text-indigo-300"
        >
          Learn
        </p>
        <h1
          class="page-title mt-5 font-display text-4xl font-semibold tracking-[-0.03em] text-stone-950 sm:text-6xl dark:text-stone-50"
        >
          沿着学科脉络，建立长期可维护的知识结构喵~
        </h1>
        <p
          class="page-description mt-6 text-base leading-8 text-stone-600 sm:text-lg dark:text-stone-400"
        >
          从领域进入学科，再沿章节阅读每一篇笔记，即使不使用搜索也能抵达全部公开知识内容喵~
        </p>
      </div>

      <div class="mt-14 space-y-16">
        {
          Object.entries(DOMAINS).map(([domainId, domain]) => {
            const subjects = getSubjectsForDomain(domainId);
            const domainNotes = notes.filter(({ data }) => data.domain === domainId);

            return (
              <section aria-labelledby={`domain-${domainId}`}>
                <div class="flex flex-col gap-4 border-b border-stone-200 pb-5 sm:flex-row sm:items-end sm:justify-between dark:border-stone-800">
                  <div>
                    <p class="text-xs font-bold tracking-[0.18em] text-indigo-700 uppercase dark:text-indigo-300">
                      {domain.englishLabel}
                    </p>
                    <h2
                      id={`domain-${domainId}`}
                      class="mt-2 font-display text-3xl font-bold text-stone-950 dark:text-stone-50"
                    >
                      {domain.label}
                    </h2>
                  </div>
                  <a
                    href={`/learn/${domain.slug}`}
                    class="inline-flex min-h-11 items-center rounded-xl px-3 text-sm font-semibold text-stone-600 transition hover:bg-stone-200/70 hover:text-indigo-800 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-700 dark:text-stone-300 dark:hover:bg-stone-800 dark:hover:text-indigo-200 dark:focus-visible:outline-indigo-300"
                  >
                    查看领域 · {domainNotes.length} Notes{" "}
                    <span class="ml-2" aria-hidden="true">
                      →
                    </span>
                  </a>
                </div>
                <div class="mt-6 grid gap-5 md:grid-cols-2 xl:grid-cols-3">
                  {subjects.map((subjectId, index) => (
                    <SubjectCard
                      subjectId={subjectId}
                      notes={domainNotes.filter(({ data }) => data.subject === subjectId)}
                      index={index}
                    />
                  ))}
                </div>
              </section>
            );
          })
        }
      </div>
    </Container>
  </section>
</BaseLayout>
