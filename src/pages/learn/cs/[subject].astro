---
import LearnSubjectPage from "../../../components/learn/LearnSubjectPage.astro";
import { getSubjectsForDomain, type SubjectId } from "../../../config/subjects";
import { getNotesBySubject } from "../../../utils/notes";

interface Props {
  subjectId: SubjectId;
}

export function getStaticPaths() {
  const publicSlugBySubject: Record<string, string> = {
    "data-structures": "data-structures",
    "computer-organization": "computer-organization",
    "operating-systems": "os",
    "computer-networks": "network",
  };

  return getSubjectsForDomain("computer-science").map((subjectId) => ({
    params: { subject: publicSlugBySubject[subjectId] },
    props: { subjectId },
  }));
}

const { subjectId } = Astro.props;
const notes = await getNotesBySubject(subjectId);
---

<LearnSubjectPage subjectId={subjectId} notes={notes} />
